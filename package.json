{
  "name": "homepage-manager",
  "version": "1.0.0",
  "description": "A polished, self-hosted web app for editing and managing your Homepage (gethomepage.dev) configuration.",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "npm run dev -w web",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.build.json",
    "build:web": "npm run build -w web",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "chokidar": "^3.6.0",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0",
    "monaco-editor": "^0.50.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
