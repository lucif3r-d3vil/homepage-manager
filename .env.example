# ---------------------------------------------------------------------------
# Homepage Manager — environment configuration
# Copy to `.env` (or set in your shell / Docker) and adjust as needed.
# All variables are OPTIONAL.
# ---------------------------------------------------------------------------

# Port the server listens on (default: 3001).
PORT=3001

# Interface to bind (default: 0.0.0.0). Leave as-is for Docker/previews.
HOST=0.0.0.0

# Where Homepage Manager stores its own settings + version history.
# Default: ./data (when running outside Docker)
HOMEPAGE_MANAGER_DATA_DIR=/app/data

# ---- Docker compose helpers -----------------------------------------------
# The UID/GID the app process should run as. This lets the container write to a
# Homepage config directory you own on the host (run `id -u` / `id -g` to find
# yours). Defaults to 1000:1000.
PUID=1000
PGID=1000
